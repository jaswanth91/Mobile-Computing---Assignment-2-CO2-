
import numpy as np
import matplotlib.pyplot as plt
import math

# Given values
chip_rate = 1228800
data_rate = 9600

# Processing gain
Gp = chip_rate / data_rate
Gp_db = 10 * np.log10(Gp)

print("CDMA Processing Gain:", Gp)
print("Processing Gain in dB:", round(Gp_db, 2), "dB")

# BER calculation for coherent BPSK
EbN0_db = np.arange(0, 11, 1)
EbN0_linear = 10 ** (EbN0_db / 10)

BER = np.array([
    0.5 * math.erfc(math.sqrt(value))
    for value in EbN0_linear
])

print("\nBER Values:")
for snr, ber in zip(EbN0_db, BER):
    print(f"{snr} dB : {ber:.6f}")

# Graph 1: BER
plt.figure(figsize=(8, 5))
plt.semilogy(EbN0_db, BER, marker="o")

plt.xlabel("Eb/N0 (dB)")
plt.ylabel("Bit Error Rate")
plt.title("CDMA - BPSK Bit Error Rate")
plt.grid(True, which="both")
plt.tight_layout()
plt.show()

# Graph 2: Processing gain
plt.figure(figsize=(7, 5))
plt.bar(["CDMA"], [Gp_db])

plt.ylabel("Processing Gain (dB)")
plt.title("CDMA Processing Gain")
plt.grid(axis="y", alpha=0.3)
plt.tight_layout()
plt.show()
